COVERAGEPROOF_DB=data/coverageproof.sqlite
# Dev mode is deterministic and explicitly labeled. Set openai to enable model planning.
COVERAGEPROOF_PROVIDER=development
OPENAI_API_KEY=
OPENAI_MODEL=
# Local single analyst only; do not expose without authentication/reverse proxy.
COVERAGEPROOF_HOST=127.0.0.1

# To use the model already installed in Ollama, no API key required:
# COVERAGEPROOF_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:9b
