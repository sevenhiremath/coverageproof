FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY coverageproof ./coverageproof
COPY tests ./tests
COPY samples/recorded-nmap ./samples/recorded-nmap
RUN pip install --no-cache-dir '.[test]' && useradd --create-home tester
USER tester
ENV PYTHONDONTWRITEBYTECODE=1 COVERAGEPROOF_DB=/tmp/coverageproof-test.sqlite
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
